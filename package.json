{
  "name": "@gg-utils/knowledge-dashboard-kit",
  "version": "0.2.0",
  "description": "Config-driven knowledge dashboard scanning and HTTP server helpers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./port-config": {
      "types": "./dist/port-config.d.ts",
      "default": "./dist/port-config.js"
    },
    "./scan": {
      "types": "./dist/scan.d.ts",
      "default": "./dist/scan.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "assets/",
    "dist/",
    "README.md",
    "LICENSE",
    "examples/"
  ],
  "engines": {
    "node": ">=22.0.0 <27",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test \"src/**/*.unit.test.ts\"",
    "lint": "eslint --max-warnings 0 .",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gg-utils/knowledge-dashboard-kit.git"
  }
}
